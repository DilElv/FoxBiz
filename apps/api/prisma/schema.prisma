generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  outlets   Outlet[]
  users     User[]
  sessions  Session[]
  products  Product[]
  address   String   @default("")
  timezone  String   @default("Asia/Jakarta")
  currency  String   @default("IDR")
  roles     Role[]
  categories Category[]
  auditLogs AuditLog[]
  sales Sale[]
  heldCarts HeldCart[]
  stockDocuments StockDocument[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  financeEntries FinanceEntry[]
  customers Customer[]
  employees Employee[]
  attendances Attendance[]
  @@unique([id, slug])
  @@index([slug])
  @@map("tenants")
}

model Outlet {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  code     String
  status   String @default("active")
  address  String @default("")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  members  UserOutlet[]
  balances StockBalance[]
  movements StockMovement[]
  sales Sale[]
  heldCarts HeldCart[]
  stockDocuments StockDocument[] @relation("StockSource")
  incomingTransfers StockDocument[] @relation("StockDestination")
  purchaseOrders PurchaseOrder[]
  financeEntries FinanceEntry[]
  employees EmployeeOutlet[]
  attendances Attendance[]
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("outlets")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  email        String
  passwordHash String   @map("password_hash")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sessions     Session[]
  roleId       String? @map("role_id") @db.Uuid
  allOutlets   Boolean @default(false) @map("all_outlets")
  role         Role? @relation(fields: [tenantId, roleId], references: [tenantId, id])
  outlets      UserOutlet[]
  sales Sale[]
  heldCarts HeldCart[]
  stockDocuments StockDocument[] @relation("StockCreator")
  receivedTransfers StockDocument[] @relation("StockReceiver")
  purchaseOrders PurchaseOrder[]
  goodsReceipts GoodsReceipt[]
  financeEntries FinanceEntry[] @relation("FinanceCreator")
  voidedFinanceEntries FinanceEntry[] @relation("FinanceVoider")
  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  @@index([tenantId, expiresAt])
  @@map("sessions")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sku          String
  barcode      String?
  name         String
  sellingPrice Decimal  @map("selling_price") @db.Decimal(14, 2)
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  categoryId   String? @map("category_id") @db.Uuid
  category     Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  unit         String @default("pcs")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  balances     StockBalance[]
  movements    StockMovement[]
  saleItems SaleItem[]
  stockDocumentItems StockDocumentItem[]
  purchaseOrderItems PurchaseOrderItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, status, name])
  @@map("products")
}

model Sale {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  cashierId String @map("cashier_id") @db.Uuid
  receiptNo String @map("receipt_no")
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash")
  status String @default("paid")
  subtotal Decimal @db.Decimal(14, 2)
  discount Decimal @default(0) @db.Decimal(14, 2)
  tax Decimal @default(0) @db.Decimal(14, 2)
  total Decimal @db.Decimal(14, 2)
  receiptSnapshot Json @map("receipt_snapshot")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  cashier User @relation(fields: [tenantId, cashierId], references: [tenantId, id])
  customerId String? @map("customer_id") @db.Uuid
  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id])
  items SaleItem[]
  payment Payment?
  @@unique([tenantId, id])
  @@unique([tenantId, receiptNo])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId, createdAt])
  @@index([tenantId, customerId, status, createdAt])
  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  saleId String @map("sale_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  name String
  sku String
  unit String
  quantity Decimal @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  @@unique([tenantId, saleId, productId])
  @@map("sale_items")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  saleId String @unique @map("sale_id") @db.Uuid
  method String
  status String
  amount Decimal @db.Decimal(14, 2)
  tendered Decimal @db.Decimal(14, 2)
  change Decimal @db.Decimal(14, 2)
  manualConfirmedBy String? @map("manual_confirmed_by") @db.Uuid
  confirmedAt DateTime @map("confirmed_at")
  sale Sale @relation(fields: [tenantId, saleId], references: [tenantId, id])
  @@unique([tenantId, saleId])
  @@map("payments")
}

model HeldCart {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  cashierId String @map("cashier_id") @db.Uuid
  label String
  items Json
  version Int @default(1)
  status String @default("held")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  cashier User @relation(fields: [tenantId, cashierId], references: [tenantId, id])
  customerId String? @map("customer_id") @db.Uuid
  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id])
  @@index([tenantId, outletId, cashierId, status])
  @@map("held_carts")
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name String
  code String
  permissions String[]
  tenant Tenant @relation(fields: [tenantId], references: [id])
  users User[]
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("roles")
}

model UserOutlet {
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  user User @relation(fields: [tenantId, userId], references: [tenantId, id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  @@id([tenantId, userId, outletId])
  @@map("user_outlets")
}

model Employee {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String
  name       String
  position   String   @default("")
  phone      String   @default("")
  status     String   @default("active")
  pinHash    String?  @map("pin_hash")
  allOutlets Boolean  @default(true) @map("all_outlets")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  outlets    EmployeeOutlet[]
  attendances Attendance[]
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status, name])
  @@map("employees")
}

model EmployeeOutlet {
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  outletId   String @map("outlet_id") @db.Uuid
  employee   Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id])
  outlet     Outlet   @relation(fields: [tenantId, outletId], references: [tenantId, id])
  @@id([tenantId, employeeId, outletId])
  @@map("employee_outlets")
}

model Attendance {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  outletId         String    @map("outlet_id") @db.Uuid
  workDate         String    @map("work_date") @db.VarChar(10)
  clockInAt        DateTime  @map("clock_in_at")
  clockOutAt       DateTime? @map("clock_out_at")
  clockInPhoto     String?   @map("clock_in_photo")
  clockOutPhoto    String?   @map("clock_out_photo")
  clockInPhotoHash  String?  @map("clock_in_photo_hash")
  clockOutPhotoHash String?  @map("clock_out_photo_hash")
  clockInLatitude  Float?    @map("clock_in_latitude")
  clockInLongitude Float?    @map("clock_in_longitude")
  clockInAccuracy  Float?    @map("clock_in_accuracy")
  clockOutLatitude  Float?   @map("clock_out_latitude")
  clockOutLongitude Float?   @map("clock_out_longitude")
  clockOutAccuracy  Float?   @map("clock_out_accuracy")
  source           String    @default("kiosk")
  recordedBy       String    @map("recorded_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  employee         Employee  @relation(fields: [tenantId, employeeId], references: [tenantId, id])
  outlet           Outlet    @relation(fields: [tenantId, outletId], references: [tenantId, id])
  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, outletId, workDate])
  @@index([tenantId, employeeId, clockOutAt])
  @@map("attendances")
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name String
  status String @default("active")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  products Product[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("categories")
}

model StockBalance {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Decimal @default(0) @db.Decimal(14, 3)
  lowStockThreshold Decimal @default(0) @map("low_stock_threshold") @db.Decimal(14, 3)
  openedAt DateTime? @map("opened_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  @@unique([tenantId, outletId, productId])
  @@index([tenantId, outletId])
  @@map("stock_balances")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Decimal @db.Decimal(14, 3)
  movementType String @map("movement_type")
  reference String
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  note String @default("")
  beforeQuantity Decimal? @map("before_quantity") @db.Decimal(14, 3)
  afterQuantity Decimal? @map("after_quantity") @db.Decimal(14, 3)
  @@unique([tenantId, outletId, productId, reference])
  @@index([tenantId, outletId, createdAt])
  @@map("stock_movements")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  action String
  entityType String @map("entity_type")
  entityId String @map("entity_id")
  beforeData Json? @map("before_data")
  afterData Json? @map("after_data")
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model StockDocument {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  destinationOutletId String? @map("destination_outlet_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid
  receivedBy String? @map("received_by") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash")
  kind String
  status String
  note String
  externalReference String @default("") @map("external_reference")
  createdAt DateTime @default(now()) @map("created_at")
  receivedAt DateTime? @map("received_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation("StockSource", fields: [tenantId, outletId], references: [tenantId, id])
  destinationOutlet Outlet? @relation("StockDestination", fields: [tenantId, destinationOutletId], references: [tenantId, id])
  creator User @relation("StockCreator", fields: [tenantId, createdBy], references: [tenantId, id])
  receiver User? @relation("StockReceiver", fields: [tenantId, receivedBy], references: [tenantId, id])
  items StockDocumentItem[]
  goodsReceipt GoodsReceipt?
  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId, createdAt])
  @@index([tenantId, destinationOutletId, status])
  @@map("stock_documents")
}

model StockDocumentItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  name String
  sku String
  unit String
  quantity Decimal @db.Decimal(14, 3)
  document StockDocument @relation(fields: [tenantId, documentId], references: [tenantId, id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  @@unique([tenantId, documentId, productId])
  @@map("stock_document_items")
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name String
  contact String @default("")
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, status, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid
  supplierName String @map("supplier_name")
  createdBy String @map("created_by") @db.Uuid
  poNo String @map("po_no")
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash")
  status String @default("draft")
  version Int @default(1)
  note String @default("")
  cancelReason String? @map("cancel_reason")
  total Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  orderedAt DateTime? @map("ordered_at")
  cancelledAt DateTime? @map("cancelled_at")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  creator User @relation(fields: [tenantId, createdBy], references: [tenantId, id])
  items PurchaseOrderItem[]
  receipts GoodsReceipt[]
  @@unique([tenantId, id])
  @@unique([tenantId, poNo])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  name String
  sku String
  unit String
  qtyOrdered Decimal @map("qty_ordered") @db.Decimal(14, 3)
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(14, 3)
  unitCost Decimal @map("unit_cost") @db.Decimal(14, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  purchaseOrder PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  receiptItems GoodsReceiptItem[]
  @@unique([tenantId, purchaseOrderId, productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  stockDocumentId String @unique @map("stock_document_id") @db.Uuid
  receivedBy String @map("received_by") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at")
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash")
  status String @default("posted")
  note String
  externalReference String @default("") @map("external_reference")
  purchaseOrder PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id])
  stockDocument StockDocument @relation(fields: [tenantId, stockDocumentId], references: [tenantId, id])
  receiver User @relation(fields: [tenantId, receivedBy], references: [tenantId, id])
  items GoodsReceiptItem[]
  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, purchaseOrderId, receivedAt])
  @@unique([tenantId, stockDocumentId])
  @@unique([tenantId, id, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  goodsReceiptId String @map("goods_receipt_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  qtyReceived Decimal @map("qty_received") @db.Decimal(14, 3)
  goodsReceipt GoodsReceipt @relation(fields: [tenantId, goodsReceiptId, purchaseOrderId], references: [tenantId, id, purchaseOrderId])
  orderItem PurchaseOrderItem @relation(fields: [tenantId, purchaseOrderId, productId], references: [tenantId, purchaseOrderId, productId])
  @@unique([tenantId, goodsReceiptId, productId])
  @@map("goods_receipt_items")
}

model FinanceEntry {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  outletId String @map("outlet_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestHash String @map("request_hash")
  kind String
  category String
  amount Decimal @db.Decimal(14, 2)
  businessDate DateTime @map("business_date") @db.Date
  note String
  status String @default("posted")
  createdAt DateTime @default(now()) @map("created_at")
  voidedAt DateTime? @map("voided_at")
  voidedBy String? @map("voided_by") @db.Uuid
  voidReason String? @map("void_reason")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [tenantId, outletId], references: [tenantId, id])
  creator User @relation("FinanceCreator", fields: [tenantId, createdBy], references: [tenantId, id])
  voider User? @relation("FinanceVoider", fields: [tenantId, voidedBy], references: [tenantId, id])
  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId, businessDate, status])
  @@map("finance_entries")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  phone     String
  email     String?
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sales     Sale[]
  heldCarts HeldCart[]
  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

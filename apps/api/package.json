{
  "name": "@foxbiz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/database.cjs deploy",
    "db:status": "node scripts/database.cjs status",
    "test": "node --require ts-node/register --test test/foundation.test.ts",
    "test:integration": "node --require ts-node/register --test --test-concurrency=1 test/tenant.integration.test.ts test/sprint1.integration.test.ts test/pos.integration.test.ts test/stock.integration.test.ts test/purchasing.integration.test.ts test/finance.integration.test.ts test/crm.integration.test.ts test/hris.integration.test.ts test/dashboard.integration.test.ts",
    "attendance:purge": "node scripts/purge-attendance.cjs",
    "db:seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}

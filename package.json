{
  "name": "foxbiz",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "start:web": "npm --workspace apps/web run start",
    "start:api": "npm --workspace apps/api run start",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "lint": "eslint apps packages --max-warnings=0",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:status": "npm --workspace apps/api run db:status",
    "db:seed": "npm --workspace apps/api run db:seed",
    "test": "npm --workspace apps/api run test",
    "test:integration": "npm --workspace apps/api run test:integration",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:sprint1": "node scripts/smoke-sprint1.mjs",
    "smoke:pos": "node scripts/smoke-pos.mjs",
    "smoke:registration": "node scripts/smoke-registration.mjs",
    "smoke:inventory": "node scripts/smoke-inventory.mjs",
    "smoke:purchasing": "node scripts/smoke-purchasing.mjs",
    "smoke:finance": "node scripts/smoke-finance.mjs",
    "smoke:crm": "node scripts/smoke-crm.mjs",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}

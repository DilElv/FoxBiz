[Unit]
Description=FoxBiz production web
After=network.target foxbiz-api.service
Wants=foxbiz-api.service

[Service]
Type=simple
User=foxbiz
Group=foxbiz
WorkingDirectory=/opt/foxbiz/current
EnvironmentFile=/etc/foxbiz/production.env
ExecStart=/usr/bin/npm --workspace apps/web run start -- --port 3500
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/foxbiz
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
